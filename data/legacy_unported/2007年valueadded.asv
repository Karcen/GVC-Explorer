%2007年嵌入中国区域的全球投入产出表，计算WWZ中分行业出口分解公式。同时也计算TIVA。
%中国分为8个区域，41个国家，每个国家（区域）的产品分为17个部门。

clear all
S=48                 %这里输入投入产出表中的国家（区域）数据。
N=17                 %这里输入每个国家（区域）的行业数。

G=xlsread('2007global.xlsx','sheet2')    % 从excel中读取数据 819*961


AA=G([1:S*N], [1:S*N])                  %取中间投入矩阵816*816
VA=G([S*N+2], [1:S*N])                  % 取增加值
TI=G([S*N+3], [1:S*N])                  %取总投入
TTI=inv(diag(TI,0) )                    %总投入矩阵对角化,并取倒数。
A=AA*TTI                               %直接消耗系数矩阵
v=VA*TTI                            %增加值系数向量
I=eye(S*N)                          %单位矩阵,单位矩阵生成函数
I1=eye(N)                           %部门数的单位矩阵
B=inv(I-A)                          %求列奥列夫逆矩阵，这个矩阵是一个全局的逆矩阵。
% 以下主要怎样利用循环语句从大矩阵中取按国家分的矩阵。
%使用单元组的处理方法，MATLAB处理矩阵的一个优势。
%模型中一定要知道数字对应的国家和部门。
%利用循环语句进行赋值。


FA=cell(S,S)                                         % 生成一个48*48**3的单元矩阵。celldisp
for i=1:1:S,
    for j=1:1:S
    FA{i,j}=A([(i-1)*N+1:i*N],[(j-1)*N+1:j*N]);      %取A中的出j对i国家（区域）的直接消耗系数矩阵。
    end
end                                     %提出分块矩阵
celldisp(FA, 'direct matrix')           %显示分块直接消耗系数矩阵

L=cell(1,S)                             %S个国家（区域）的局部逆矩阵。一个很好的矩阵。
for i=1:1:S,
L{1,i}=inv(I1-FA{i,i});
end                                     %求局部逆矩阵中的单元
celldisp(L, 'Local inverse  matrix')    %显示局部逆矩阵的单元


FB=cell(S,S)                            % 生成一个48*48的单元组。celldisp
for i=1:1:S,
    for j=1:1:S
FB{i,j}=B([(i-1)*N+1:i*N],[(j-1)*N+1:j*N]);  %提取分块矩阵，取A中的j对i国家的完全消耗系数矩阵。
    end
end                                     
celldisp(FB, 'complete matrix')               %显示分块完全消耗系数矩阵


FV=cell(1,S)                               %对增加值率分块。
for i=1:1:S
    FV{1,i}=v(1,[(i-1)*N+1:i*N])      
end                                        %循环获取增加值率分块矩阵。
celldisp(FV,'value added rate')            %显示增加值率分块矩阵。

%因为最终需求矩阵分为消费、投资和存货，每一国家（区域）对应3列。
Y=G([1:N*S],[N*S+1:(N*S+3*S)])             %提出最终需求矩阵。     
 FY=cell(S,S)                              %生成一个3*3的单元矩阵。celldisp               
 for i=1:1:S,
     for j=1:1:S
         FY{i,j}=Y([(i-1)*N+1:i*N],[(j-1)*3+1:j*3])*ones(3,1);   %由于提取后，最终需求矩阵的数据重新排列后，注意列的选取。 
     end
 end
 celldisp(FY,'final demand')                                     %循环语句计算最终需求分块矩阵，并显示。
 
 
 
 %方法一，直接从中间投入矩阵提取双边国家中间产品出口矩阵。
 DEI=cell(S,S)    %定义双边中间投入单元。
  for i=1:1:S,
    for j=1:1:S,
         if j==i
            DEI{i,j}=[ ] 
         else
            DEI{i,j}=G([(i-1)*N+1:i*N],[(j-1)*N+1:j*N ])*ones(N,1)  %i 国出口到j国的分行业的中间产品。
         end
    end
  end
 celldisp(DEI,'Intermediate export')
 
 
%总出口直接从全球投入矩阵中取。
 TE=cell(S,1)
 for i=1:1:S
     TE{i,1}=0
     for j=1:1:S
         if j==i,
             TE{i,1}=TE{i,1}+zeros(N,1)
         else
         TE{i,1}=TE{i,1}+DEI{i,j}+FY{i,j}
         end
     end
 end
 celldisp(TE,'total export')
 
 
%方法2，利用逆矩阵计算。中间投入的ABY分解。 

 
 EI=cell(S,S)                         %定义双边国家出口向量。
 
 %具体找对中间产品出口的数据进行check
   t=FA{1,2}*FB{2,2}*FY{2,2}          % 间接检验第一数据是否正确。
      
 %从最终需求矩阵计算中间产品出口  计算i国到j国的中间产品出口。
 tt2=cell(S,S)              %j国生产的自己消费的最终产品，引致的对i国的中间产品进口。
 for i=1:1:S,
    for j=1:1:S,
         if j==i
            tt2{i,j}=[ ] 
         else
             tt2{i,j}=FA{i,j}*FB{j,j}*FY{j,j}
         end
    end
 end
 celldisp(tt2)
            
             
   tt3=cell(S,S)              %第三方国家t消费自己的最终产品对j国生产中间品，引致的对i国的中间产品进口。
 for i=1:1:S,
    for j=1:1:S,
         if j==i
            tt3{i,j}=[ ] 
         else
            tt3{i,j}=zeros(N,1)
             for t=1:1:S, 
             tt3{i,j}=tt3{i,j}+FA{i,j}*FB{j,t}*FY{t,t}
             end
             tt3{i,j}=tt3{i,j}-FA{i,j}*FB{j,i}*FY{i,i}-FA{i,j}*FB{j,j}*FY{j,j}
         end
    end
 end
   celldisp(tt3)                  
             
 tt4=cell(S,S)              %j生产的产品出口到第三方国家t作为最终消费，引致的对i国的中间产品进口。
 for i=1:1:S,
    for j=1:1:S,
         if j==i
            tt4{i,j}=[ ] 
         else 
             tt4{i,j}= zeros(N,1)
             for t=1:1:S, 
                 tt4{i,j}=tt4{i,j}+FA{i,j}*FB{j,j}*FY{j,t}
             end
             tt4{i,j}=tt4{i,j}-FA{i,j}*FB{j,j}*FY{j,i}-FA{i,j}*FB{j,j}*FY{j,j}
         end
    end
 end                        
 celldisp(tt4)

  tt5=cell(S,S)              %        引致的对i国的中间产品进口。
 for i=1:1:S,
    for j=1:1:S,
         if j==i
            tt5{i,j}=[ ] 
         else
             tt5{i,j}= zeros(N,1)
             for t=1:1:S, 
                tt5{i,j}=tt5{i,j}+FA{i,j}*FB{j,t}*FY{t,j}
             end
             tt5{i,j}=tt5{i,j}-FA{i,j}*FB{j,j}*FY{j,i}-FA{i,j}*FB{j,j}*FY{j,j}
         end
    end
 end             
 celldisp(tt5)


 tt6=cell(S,S)        %i出口到j国的中间产品，用来生产j国的产品并且作为i国的最终消费。     
 for i=1:1:S,
    for j=1:1:S,
         if j==i
            tt6{i,j}=[ ] 
         else
            tt6{i,j}= FA{i,j}*FB{j,j}*FY{j,i}     
         end
    end
 end             
 celldisp(tt6)


  tt7=cell(S,S)              %        引致的对i国的中间产品进口。
 for i=1:1:S,
    for j=1:1:S,
         if j==i
            tt7{i,j}=[ ] 
         else
            tt7{i,j}= zeros(N,1)
             for t=1:1:S, 
                tt7{i,j}=tt7{i,j}+FA{i,j}*FB{j,t}*FY{t,i} 
             end
             tt7{i,j}=tt7{i,j}-FA{i,j}*FB{j,j}*FY{j,i}-FA{i,j}*FB{j,i}*FY{i,i}
         end
    end
 end             
 celldisp(tt7)


 tt8=cell(S,S)              %        引致的对i国的中间产品进口。
 for i=1:1:S,
    for j=1:1:S,
         if j==i
            tt8{i,j}=[ ] 
         else
           tt8{i,j}=FA{i,j}*FB{j,i}*FY{i,i}    
         end
    end
 end             
 celldisp(tt8)


  tt9=cell(S,S)              %        引致的对i国的中间产品进口。
 for i=1:1:S,
    for j=1:1:S,
         if j==i
            tt9{i,j}=[ ] 
         else
              tt9{i,j}=zeros(N,1) 
             for t=1:1:S,    
               tt9{i,j}=tt9{i,j}+FA{i,j}*FB{j,i}*FY{i,t}  
              end
             tt9{i,j}=tt9{i,j}-FA{i,j}*FB{j,i}*FY{i,i}
         end
    end
 end             
 celldisp(tt9)
 
 
 for i=1:1:S,
    for j=1:1:S,
         if j==i
            EI{i,j}=[ ] 
         else
          EI{i,j}=tt2{i,j}+tt3{i,j}+tt4{i,j}+tt5{i,j}+tt6{i,j}+tt7{i,j}+tt8{i,j}+tt9{i,j}  
         end
    end
 end             
 celldisp(EI)
 
CheckEI=cell(S,S)

for i=1:1:S,
    for j=1:1:S,
         if j==i
            CheckEI{i,j}=[ ] 
         else
          CheckEI{i,j}=DEI{i,j}-EI{i,j} 
         end
    end
 end             
 celldisp(CheckEI)
 
 %中间投入利用局部逆矩阵计算
 LEI=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             LEI{i,j}=[ ]
         else
          LEI{i,j}=FA{i,j}*L{1,j}*FY{j,j}+FA{i,j}*L{1,j}*TE{j,1}
         end
     end
 end
 celldisp(LEI,'total bilateral export')
 
 
 %双边国家的总出口的16项分解公式计算
 T1=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T1{i,j}=[]
         else
           T1{i,j}=(FV{1,i}*FB{i,i})'.*FY{i,j}
         end
     end
 end 
 celldisp(T1)
 
 
 T2=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T2{i,j}=[]
         else
           T2{i,j}=(FV{1,i}*L{1,i})'.*tt2{i,j}
         end
     end
 end 
 celldisp(T2)
 
 
 T3=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T3{i,j}=[]
         else
           T3{i,j}=(FV{1,i}*L{1,i})'.*tt3{i,j}
         end
     end
 end 
 celldisp(T3)

 T4=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T4{i,j}=[]
         else
           T4{i,j}=(FV{1,i}*L{1,i})'.*tt4{i,j}
         end
     end
 end 
 celldisp(T4)
 
  T5=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T5{i,j}=[]
         else
           T5{i,j}=(FV{1,i}*L{1,i})'.*tt5{i,j}
         end
     end
 end 
 celldisp(T5)
 
 
   T6=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T6{i,j}=[]
         else
           T6{i,j}=(FV{1,i}*L{1,i})'.*tt6{i,j}
         end
     end
 end 
 celldisp(T6)
 
  T7=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T7{i,j}=[]
         else
           T7{i,j}=(FV{1,i}*L{1,i})'.*tt7{i,j}
         end
     end
 end 
 celldisp(T7)

 T8=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T8{i,j}=[]
         else
           T8{i,j}=(FV{1,i}*L{1,i})'.*tt8{i,j}
         end
     end
 end 
 celldisp(T8)
 
  T9=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T9{i,j}=[]
         else
           T9{i,j}=(FV{1,i}*L{1,i})'.*tt9{i,j}
         end
     end
 end 
 celldisp(T9)
 
   T10=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T10{i,j}=[]
         else
           T10{i,j}=(FV{1,i}*FB{i,i}-FV{1,i}*L{1,i})'.*DEI{i,j}
         end
     end
 end 
 celldisp(T10)
 
  T11=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T11{i,j}=[]
         else
           T11{i,j}=(FV{1,j}*FB{j,i})'.*FY{i,j}
         end
     end
 end 
 celldisp(T11)
 
 
  T12=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T12{i,j}=[]
         else
           T12{i,j}=(FV{1,j}*FB{j,i})'.*(FA{i,j}*L{1,j}*FY{j,j})
         end
     end
 end 
 celldisp(T12)
 
 
  
  T13=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T13{i,j}=[]
         else
           T13{i,j}=(FV{1,j}*FB{j,i})'.*(FA{i,j}*L{1,j}*TE{j,1})
         end
     end
 end 
 celldisp(T13)
 
 
%计算其他国家在出口中体现的增加值。 
 ttother=cell(S,S)
 for  i=1:1:S
     for j=1:1:S 
        if j==i
             ttother{i,j}=[]
        else
            ttother{i,j}=zeros(1,N)
            for t=1:1:S
            ttother{i,j}= ttother{i,j}+FV{1,t}*FB{t,i}
            end
            ttother{i,j}=ttother{i,j}-FV{1,i}*FB{i,i}-FV{1,j}*FB{j,i}
        end
     end
 end
 
 celldisp(ttother)
 
  T14=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T14{i,j}=[]
         else
           T14{i,j}=(ttother{i,j})'.*FY{i,j}
         end
     end
 end 
 celldisp(T14) 
 
   T15=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T15{i,j}=[]
         else
           T15{i,j}=(ttother{i,j})'.*(FA{i,j}*L{1,j}*FY{j,j})
         end
     end
 end 
 celldisp(T15) 
 
    T16=cell(S,S)
 for i=1:1:S
     for j=1:1:S
         if j==i
             T16{i,j}=[]
         else
           T16{i,j}=(ttother{i,j})'.*(FA{i,j}*L{1,j}*TE{j,1})
         end
     end
 end 
 celldisp(T16) 
 
 %计算i到j国的产业总出口，check是否与总出口一致。
 
 SFTE=cell(S,S)
 CheckSTE=cell(S,S)

 
 
 for i=1:1:S
     for j=1:1:S
         if j==i
             SFTE{i,j}=[]  
         else 
             
             SFTE{i,j}=T1{i,j}+T2{i,j}+T3{i,j}+T4{i,j}+T5{i,j}+T6{i,j}+T7{i,j}+T8{i,j}+T9{i,j}+T10{i,j}+T11{i,j}+T12{i,j}+T13{i,j}+T14{i,j}+T15{i,j}+T16{i,j}
         end
     end
 end
 
  for i=1:1:S
     for j=1:1:S
         if j==i
             CheckSTE{i,j}=[]
         else 
          CheckSTE{i,j}=DEI{i,j}+FY{i,j}-SFTE{i,j}
         end
     end
 end

 celldisp(SFTE)
 celldisp(CheckSTE)           


